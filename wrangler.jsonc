{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "surajgoraya-ca",
	"compatibility_date": "2026-08-20",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true
	}
}
